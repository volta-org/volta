<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <!-- Allow suppression via @SuppressWarnings("checkstyle:RuleName") -->
    <module name="SuppressWarningsFilter"/>

    <module name="TreeWalker">

        <!-- Required for @SuppressWarnings to work -->
        <module name="SuppressWarningsHolder"/>

        <!-- ===== NAMING CONVENTIONS ===== -->

        <!-- Classes, interfaces, enums, records: PascalCase -->
        <module name="TypeName"/>

        <!-- Methods: camelCase -->
        <module name="MethodName"/>

        <!-- Local variables: camelCase -->
        <module name="LocalVariableName"/>

        <!-- Class fields: camelCase -->
        <module name="MemberName"/>

        <!-- Method parameters: camelCase -->
        <module name="ParameterName"/>

        <!-- static final constants: UPPER_SNAKE_CASE -->
        <!-- Exceptions: log, logger -->
        <module name="ConstantName">
            <property name="format"
                      value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$|^log(ger)?$"/>
        </module>

        <!-- Packages: all lowercase -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- ===== IMPORTS ===== -->

        <!-- No wildcard imports (import java.util.*) -->
        <module name="AvoidStarImport"/>

        <!-- No unused imports -->
        <module name="UnusedImports"/>

        <!-- ===== CODE STYLE ===== -->

        <!-- Always use braces for if/else/for/while/do -->
        <module name="NeedBraces"/>

        <!-- One statement per line (no: int a = 1; int b = 2;) -->
        <module name="OneStatementPerLine"/>

    </module>
</module>
